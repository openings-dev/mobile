{
  "name": "@openingshq/mobile",
  "version": "0.1.1",
  "description": "Private Expo application for Openings on iOS and Android.",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openings-dev/mobile.git"
  },
  "main": "expo-router/entry",
  "expo": {
    "doctor": {
      "appConfigFieldsNotSyncedCheck": {
        "enabled": false
      }
    }
  },
  "scripts": {
    "android": "expo run:android",
    "android:debug": "expo run:android --variant debug",
    "check": "npm run lint && npm run typecheck && npm test -- --runInBand && npm run doctor",
    "doctor": "expo-doctor",
    "ios": "expo run:ios",
    "ios:debug": "expo run:ios --configuration Debug",
    "lint": "eslint . --max-warnings=0",
    "prebuild": "expo prebuild",
    "security:audit": "node scripts/audit-public-readiness.mjs",
    "start": "expo start --dev-client",
    "test": "jest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo-google-fonts/figtree": "0.4.1",
    "@expo-google-fonts/geist-mono": "^0.4.3",
    "@openingshq/core": "file:../core",
    "@openingshq/design-tokens": "file:../design-tokens",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-firebase/app": "^26.3.3",
    "@react-native-firebase/crashlytics": "^26.3.3",
    "@react-native-firebase/remote-config": "26.3.3",
    "@sentry/react-native": "~7.11.0",
    "@tanstack/react-query": "^5.102.8",
    "expo": "~57.0.22",
    "expo-application": "~57.0.3",
    "expo-constants": "~57.0.18",
    "expo-dev-client": "~57.0.19",
    "expo-font": "~57.0.4",
    "expo-in-app-updates": "0.12.0",
    "expo-linking": "~57.0.10",
    "expo-localization": "~57.0.2",
    "expo-router": "~57.0.21",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "lucide-react-native": "^1.39.0",
    "mixpanel-react-native": "^3.6.0",
    "nativewind": "^4.2.6",
    "onesignal-expo-plugin": "^2.7.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-onesignal": "^5.4.6",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@react-native/jest-preset": "0.86.3",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "29.5.14",
    "@types/node": "^24.0.0",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "expo-doctor": "^1.20.2",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "react-test-renderer": "19.2.3",
    "tailwindcss": "^3.4.19",
    "test-renderer": "1.2.0",
    "typescript": "~6.0.3"
  }
}
