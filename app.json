{
  "expo": {
    "name": "Openings",
    "slug": "openings",
    "scheme": "openings",
    "version": "0.1.1",
    "icon": "./assets/images/icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "platforms": [
      "android",
      "ios"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.openings.mobile",
      "appleTeamId": "VD2G3CWSCR",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "AppStoreID": "6834098510"
      },
      "buildNumber": "1",
      "icon": "./assets/images/icon.png",
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": [
              "35F9.1"
            ]
          }
        ],
        "NSPrivacyCollectedDataTypes": [],
        "NSPrivacyTracking": false
      }
    },
    "android": {
      "package": "dev.openings.mobile",
      "googleServicesFile": "./google-services.json",
      "versionCode": 2,
      "predictiveBackGestureEnabled": true,
      "icon": "./assets/images/icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "monochromeImage": "./assets/images/monochrome-icon.png",
        "backgroundColor": "#F5F3EF"
      }
    },
    "plugins": [
      [
        "onesignal-expo-plugin",
        {
          "mode": "production",
          "iPhoneDeploymentTarget": "16.4",
          "smallIcons": [
            "./assets/images/ic_stat_onesignal_default.png"
          ],
          "smallIconAccentColor": "#187A68"
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/crashlytics",
      "./plugins/with-ios-firebase.cjs",
      "./plugins/with-ios-release.cjs",
      "@sentry/react-native/expo",
      [
        "expo-router",
        {
          "root": "src/app/routes"
        }
      ],
      "expo-localization",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F5F3EF",
          "image": "./assets/images/splash-icon.png",
          "dark": {
            "backgroundColor": "#0D1211",
            "image": "./assets/images/splash-icon-dark.png"
          },
          "imageWidth": 180,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-font",
        {
          "android": {
            "fonts": [
              {
                "fontFamily": "Figtree",
                "fontDefinitions": [
                  {
                    "path": "./node_modules/@expo-google-fonts/figtree/400Regular/Figtree_400Regular.ttf",
                    "weight": 400
                  },
                  {
                    "path": "./node_modules/@expo-google-fonts/figtree/500Medium/Figtree_500Medium.ttf",
                    "weight": 500
                  },
                  {
                    "path": "./node_modules/@expo-google-fonts/figtree/600SemiBold/Figtree_600SemiBold.ttf",
                    "weight": 600
                  }
                ]
              },
              {
                "fontFamily": "Geist Mono",
                "fontDefinitions": [
                  {
                    "path": "./node_modules/@expo-google-fonts/geist-mono/400Regular/GeistMono_400Regular.ttf",
                    "weight": 400
                  },
                  {
                    "path": "./node_modules/@expo-google-fonts/geist-mono/500Medium/GeistMono_500Medium.ttf",
                    "weight": 500
                  },
                  {
                    "path": "./node_modules/@expo-google-fonts/geist-mono/600SemiBold/GeistMono_600SemiBold.ttf",
                    "weight": 600
                  }
                ]
              }
            ]
          },
          "ios": {
            "fonts": [
              "./node_modules/@expo-google-fonts/figtree/400Regular/Figtree_400Regular.ttf",
              "./node_modules/@expo-google-fonts/figtree/500Medium/Figtree_500Medium.ttf",
              "./node_modules/@expo-google-fonts/figtree/600SemiBold/Figtree_600SemiBold.ttf",
              "./node_modules/@expo-google-fonts/geist-mono/400Regular/GeistMono_400Regular.ttf",
              "./node_modules/@expo-google-fonts/geist-mono/500Medium/GeistMono_500Medium.ttf",
              "./node_modules/@expo-google-fonts/geist-mono/600SemiBold/GeistMono_600SemiBold.ttf"
            ]
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
