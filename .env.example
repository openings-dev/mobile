# EXPO_PUBLIC_* values are public client configuration. They are extractable from
# an installed application and must never carry administrative credentials.
# Optional privacy-first crash reporting. Leave EXPO_PUBLIC_SENTRY_DSN empty
# to disable Sentry entirely (matches web's lib/telemetry gating).
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_SENTRY_ENVIRONMENT=
EXPO_PUBLIC_SENTRY_RELEASE=

# Product analytics remains disabled until explicit in-app consent is granted.
EXPO_PUBLIC_MIXPANEL_TOKEN=
EXPO_PUBLIC_MIXPANEL_API_HOST=https://api.mixpanel.com

# Public client identifier. Private OneSignal REST/APNs/FCM keys never belong here.
EXPO_PUBLIC_ONESIGNAL_APP_ID=

# Firebase Crashlytics needs no env var here — its config lives in the
# generated google-services.json (Android) and GoogleService-Info.plist
# (iOS) files, which are not committed. See
# docs/specs/2026-09-03-mobile-sentry-crashlytics-design.md for how those
# are generated once the Firebase project exists.
