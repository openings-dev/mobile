require "shellwords"
require "base64"
require "open3"

default_platform(:android)

OPENINGS_ANDROID_PACKAGE = "dev.openings.mobile"

def project_root
  File.expand_path("..", __dir__)
end

def signing_properties
  File.join(project_root, "android", "keystore.properties")
end

def release_keystore
  File.join(project_root, "android", "app", "keystore.jks")
end

def validate_signing!
  UI.user_error!("Missing android/keystore.properties") unless File.exist?(signing_properties)
  UI.user_error!("Missing android/app/keystore.jks") unless File.exist?(release_keystore)
end

def signing_certificate_sha256
  validate_signing!
  stdout, stderr, status = Open3.capture3(
    "keytool", "-list", "-v",
    "-keystore", release_keystore,
    "-storepass", ENV.fetch("ANDROID_STORE_PASSWORD", ""),
    "-alias", ENV.fetch("ANDROID_KEY_ALIAS", "")
  )
  fingerprint = stdout[/SHA-?256:\s*([0-9A-F:]+)/i, 1]
  UI.user_error!("Unable to read Android signing certificate: #{stderr.strip}") unless status.success? && fingerprint
  fingerprint.delete(":").upcase
end

def play_json_key
  path = ENV["GOOGLE_PLAY_JSON_KEY_FILE"] || File.join(project_root, "google-play-service-account.json")
  UI.user_error!("Google Play service-account JSON was not found at #{path}") unless File.exist?(path)
  path
end

def positive_version_code(options)
  value = options[:version_code] || ENV["ANDROID_VERSION_CODE"]
  UI.user_error!("version_code must be a positive integer") unless value.to_s.match?(/\A[1-9]\d*\z/)
  value.to_i
end

def release_version_name(options)
  value = options[:version_name] || ENV["ANDROID_VERSION_NAME"]
  pattern = /\A\d+\.\d+\.\d+(?:[.-][0-9A-Za-z.-]+)?\z/
  UI.user_error!("version_name must be a semantic version without the v prefix") unless value.to_s.match?(pattern)
  value
end

def github_config_set(kind, name, value)
  UI.user_error!("#{name} is required") if value.to_s.strip.empty?
  stdout, stderr, status = Open3.capture3("gh", kind, "set", name, stdin_data: value)
  UI.user_error!("Unable to set GitHub #{kind} #{name}: #{stderr.strip}") unless status.success?
  UI.success("Updated GitHub #{kind} #{name}")
end

platform :android do
  desc "Sync Android telemetry, Firebase, signing, and Play configuration to GitHub"
  lane :sync_github_config do
    variables = {
      "EXPO_PUBLIC_SENTRY_DSN" => ENV["EXPO_PUBLIC_SENTRY_DSN"],
      "EXPO_PUBLIC_SENTRY_ENVIRONMENT" => ENV.fetch("EXPO_PUBLIC_SENTRY_ENVIRONMENT", "production"),
      "EXPO_PUBLIC_MIXPANEL_TOKEN" => ENV["EXPO_PUBLIC_MIXPANEL_TOKEN"],
      "EXPO_PUBLIC_MIXPANEL_API_HOST" => ENV.fetch("EXPO_PUBLIC_MIXPANEL_API_HOST", "https://api.mixpanel.com"),
      "EXPO_PUBLIC_ONESIGNAL_APP_ID" => ENV["EXPO_PUBLIC_ONESIGNAL_APP_ID"],
      "SENTRY_ORG" => ENV.fetch("SENTRY_ORG", "openings-hq"),
      "SENTRY_PROJECT" => ENV.fetch("SENTRY_PROJECT", "openings-mobile")
    }
    variables.each { |name, value| github_config_set("variable", name, value) }

    google_services = File.join(project_root, "google-services.json")
    UI.user_error!("Missing #{google_services}") unless File.exist?(google_services)
    github_config_set(
      "secret",
      "GOOGLE_SERVICES_JSON_BASE64",
      Base64.strict_encode64(File.binread(google_services))
    )
    unless ENV["SENTRY_AUTH_TOKEN"].to_s.strip.empty?
      github_config_set("secret", "SENTRY_AUTH_TOKEN", ENV["SENTRY_AUTH_TOKEN"])
    end

    validate_signing!
    github_config_set("secret", "ANDROID_KEY_ALIAS", ENV["ANDROID_KEY_ALIAS"])
    github_config_set("secret", "ANDROID_KEY_PASSWORD", ENV["ANDROID_KEY_PASSWORD"])
    github_config_set("secret", "ANDROID_STORE_PASSWORD", ENV["ANDROID_STORE_PASSWORD"])
    github_config_set("variable", "ANDROID_SIGNING_CERT_SHA256", signing_certificate_sha256)
    github_config_set(
      "secret",
      "ANDROID_KEYSTORE_BASE64",
      Base64.strict_encode64(File.binread(release_keystore))
    )
    github_config_set(
      "secret",
      "GOOGLE_PLAY_SERVICE_ACCOUNT_JSON_BASE64",
      Base64.strict_encode64(File.binread(play_json_key))
    )
  end

  desc "Run the complete mobile repository verification"
  lane :check do
    sh("cd #{project_root.shellescape} && npm run check")
  end

  desc "Build the Android debug APK"
  lane :build_debug do
    gradle(project_dir: File.join(project_root, "android"), task: "assemble", build_type: "Debug")
  end

  desc "Build a signed Android App Bundle"
  lane :bundle_release do
    validate_signing!
    gradle_options = {
      project_dir: File.join(project_root, "android"),
      task: "bundle",
      build_type: "Release"
    }
    architectures = ENV["ANDROID_REACT_NATIVE_ARCHITECTURES"].to_s.strip
    unless architectures.empty?
      gradle_options[:properties] = { "reactNativeArchitectures" => architectures }
    end
    gradle(**gradle_options)
  end

  desc "Build and upload an explicit version to the internal track"
  lane :internal do |options|
    version_code = positive_version_code(options)
    version_name = release_version_name(options)
    ENV["ANDROID_VERSION_CODE"] = version_code.to_s
    ENV["ANDROID_VERSION_NAME"] = version_name
    bundle_release
    upload_internal(
      aab: File.join(project_root, "android", "app", "build", "outputs", "bundle", "release", "app-release.aab")
    )
  end

  desc "Upload an existing signed Android App Bundle to the internal track"
  lane :upload_internal do |options|
    aab = options[:aab]
    UI.user_error!("aab is required") unless aab
    aab = File.expand_path(aab, project_root)
    UI.user_error!("AAB was not found at #{aab}") unless File.exist?(aab)
    upload_to_play_store(
      aab: aab,
      json_key: play_json_key,
      package_name: "dev.openings.mobile",
      release_status: "completed",
      skip_upload_changelogs: true,
      skip_upload_images: true,
      skip_upload_metadata: true,
      skip_upload_screenshots: true,
      track: "internal"
    )
  end

  desc "Upload localized Google Play listing assets without changing its release"
  lane :store_listing do |options|
    version_code = positive_version_code(options)
    upload_to_play_store(
      json_key: play_json_key,
      metadata_path: File.join(project_root, "fastlane", "metadata", "android"),
      package_name: OPENINGS_ANDROID_PACKAGE,
      changes_not_sent_for_review: true,
      skip_upload_aab: true,
      skip_upload_apk: true,
      skip_upload_changelogs: true,
      track: "internal",
      version_code: version_code
    )
  end

  desc "Promote an explicit internal version to production"
  lane :production do |options|
    version_code = positive_version_code(options)
    release_status = options[:release_status] || "completed"
    UI.user_error!("release_status must be completed, draft, halted, or inProgress") unless
      %w[completed draft halted inProgress].include?(release_status)
    upload_to_play_store(
      json_key: play_json_key,
      package_name: "dev.openings.mobile",
      skip_upload_changelogs: true,
      skip_upload_images: true,
      skip_upload_metadata: true,
      skip_upload_screenshots: true,
      track: "internal",
      track_promote_to: "production",
      track_promote_release_status: release_status,
      version_code: version_code
    )
  end
end
